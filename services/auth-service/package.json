{
  "name": "pos-auth-service",
  "version": "1.0.0",
  "description": "Authentication service for POS system with custom authentication and modular architecture",
  "main": "service.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon  server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "docker:build": "docker build -t pos-auth-service .",
    "docker:run": "docker run -p 8081:8081 pos-auth-service"
  },
  "keywords": [
    "pos",
    "authentication",
    "custom-auth",
    "microservices",
    "nodejs",
    "modular",
    "mvc"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.6.12"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/**",
      "!coverage/**",
      "!node_modules/**"
    ]
  }
}
