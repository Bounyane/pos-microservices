# ─── gRPC server ────────────────────────────────────────────────────────────────
GRPC_PORT=50053
MAX_WORKERS=10

# ─── Model ──────────────────────────────────────────────────────────────────────
# Path inside the container where the trained .pkl file is located.
# Override this if you mount a pre-trained model as a Docker volume.
MODEL_PATH=models/random_forest_model.pkl

# ─── Blockchain (unused by AI model, kept for parity) ──────────────────────────
# POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
# WALLET_PRIVATE_KEY=your_private_key_here
# CONTRACT_ADDRESS=0xYourContractAddress
